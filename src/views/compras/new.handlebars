<div class="container my-5">
    <h1 class="text-center mb-5">Generar Compra</h1>
    <form action="/compras" method="POST">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-5">
                <thead class="table-dark">
                    <tr>
                        <th>Seleccionar</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Año</th>
                        <th>Precio</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each bicicletas as |bicicleta|}}
                        <tr>
                            <td><input type="checkbox" name="bicicletasSeleccionadas" value="{{bicicleta.id}}" class="form-check-input"></td>
                            <td>{{bicicleta.marca}}</td>
                            <td>{{bicicleta.modelo}}</td>
                            <td>{{bicicleta.year}}</td>
                            <td class="precio" data-precio="{{bicicleta.precio}}">${{bicicleta.precio}}</td>
                            <td><input type="number" name="cantidad_{{bicicleta.id}}" value="1" min="1" class="cantidad"></td>
                            <td class="subtotal">$0.00</td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
            <div class="d-flex justify-content-end">
                <a href="/compras" class="btn btn-dark me-2">Cancelar</a>
                <button type="submit" class="btn btn-info">Guardar Compra</button>
            </div>
        </div>
    </form>
</div>

<script src="/js/main.js"></script>